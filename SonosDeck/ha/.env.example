# Copy to .env next to compose.yaml. Never commit .env.

# Folder on the QNAP that holds the HA and Music Assistant data. Check that the share path exists.
STACK_ROOT=/share/Container/sonosdeck

# Your IANA time zone, e.g. America/Chicago. Required.
TZ=

# After installing, pin these to the exact versions and record them in VERSIONS.md.
HA_TAG=stable
MA_TAG=latest
